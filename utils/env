#!/bin/bash

#env utilities

#include guard
if isFunctionDefined "env.defined" && ! isEnvVariableDefined "FORCE_IMPORT_UTILITY"
then
  return 0
fi

function env.defined() {
  return 0
}

importutility system

# Will be kept in the root directory of the environment.
export ENV_CONFIG_FILENAME=".newton-env-config"

function env.getnumber() {
  local envNum=$(env.getproperty HOST_PROPERTIES_ENVNUM "0")
  echo "$envNum"
}

# Write a variable specific to this environment.
# example:
# myvar="Piyush Soni"
# env.writevartodisk myvar
# (Please note to pass the name of the variable only,
# not its value with the "$" symbol. Its value will
# be persistently stored on the disk, and can later
# be read back by using the same 'variable' or key name,
# see below for the reading example).
# We use the current environment number as the
# file extension to avoid variable name conflicts
function env.writevartodisk() {
  local varName="$1"
  local value="${!varName}"
  env.setproperty "$varName" "$value"
}

# Write a variable specific to this environment.
# Pass the *name* of the variable only, not its
# value with "$".
# Pass a default value as the second argument.
# e.g.:
# myvar=$(env.readvarfromdisk myvar defaultValue)
function env.readvarfromdisk() {
  local varName="$1"
  local defaultValue="$2"
  local value=$(env.getproperty "$varName")
  if string.isemptyorblank "$value"
  then
    echo "$defaultValue"
    return 1
  else
    echo "$value"
    return 0
  fi
}

# Pass the *name* of the variable only, not its
# value with "$".
function env.removevarfromdisk() {
  env.deleteproperty "$1"
  return $?
}

function env.isInitialized() {
  # Test some random functions that should be
  # available only if the environment is initialized.
  if isFunctionDefined "awsconfigure" && isFunctionDefined "_getBuildProp" && isFunctionDefined "repoDir" && isFunctionDefined "btGetBuildTools"
  then
    return 0
  else
    return 1
  fi
}


# Call like env.getproperty "<propertyname>" "[<default-value>]"
# Pass a second optional argument as the default value to echo when the
# property is not found (but return value will be 1, or FALSE)
function env.getproperty() {
  local propertyname="$1"
  local defaultvalue="${2:-}"

  if string.isemptyorblank "$propertyname"
  then
    echo "$defaultvalue"
    return 1
  fi

  # 1. First, check in env variables if it's set
  if string.isnotemptyorblank "${!propertyname}"
  then
    echo "${!propertyname}"
    return 0
  fi

  local newtonPath="$REPO_NEWTON"
  if string.isemptyorblank "$newtonPath"
  then
    newtonPath=$(string.extractByRegex "$(pwd)" "/.*/newton[0-9]*")
  fi

  # If we still can't figure out the newtonPath, exit
  if string.isemptyorblank "$newtonPath"
  then
    echo "$defaultvalue"
    return 1
  fi

  local pathsToCheck=(
    "$newtonPath/.build_config"
    "$newtonPath/buildSrc/tools/config/versions.bash"
    "$newtonPath/$ENV_CONFIG_FILENAME"
  )

  local value=""
  for filePath in "${pathsToCheck[@]}"
  do
    value="$(system.getkeyvaluefromfile "$filePath" "$propertyname")"
    if ! string.isemptyorblank "$value"
    then
      echo "$value"
      return 0
    fi
  done

  # Didn't find the key anywhere.
  echo "$defaultvalue"
  return 1
}

function env.setproperty() {
  local propertyname="$1"
  local propertyvalue="$2"

  if string.isemptyorblank "$propertyname"
  then
    echo "Usage: env.setproperty <propertyname> <propertyvalue>" >&2
    return 1
  fi

  local newtonPath="$REPO_NEWTON"
  if string.isemptyorblank "$newtonPath"
  then
    newtonPath=$(string.extractByRegex "$(pwd)" "/.*/newton[0-9]*")
  fi

  # If we still can't figure out the newtonPath, exit
  if string.isemptyorblank "$newtonPath"
  then
    echo "Error: Cannot determine newton path" >&2
    return 1
  fi

  local configFilePath="$newtonPath/$ENV_CONFIG_FILENAME"
  system.setkeyvalueinfile "$configFilePath" "$propertyname" "$propertyvalue"
  return $?
}

function env.deleteproperty() {
  local propertyname="$1"

  if string.isemptyorblank "$propertyname"
  then
    echo "Usage: env.deleteproperty <propertyname>" >&2
    return 1
  fi

  local newtonPath="$REPO_NEWTON"
  if string.isemptyorblank "$newtonPath"
  then
    newtonPath=$(string.extractByRegex "$(pwd)" "/.*/newton[0-9]*")
  fi

  # If we still can't figure out the newtonPath, exit
  if string.isemptyorblank "$newtonPath"
  then
    echo "Error: Cannot determine newton path" >&2
    return 1
  fi

  local configFilePath="$newtonPath/$ENV_CONFIG_FILENAME"
  system.deletekeyvaluefromfile "$configFilePath" "$propertyname" --silent
  return $?
}

function env.refresh() {
  mongoDropAll; mongoDropToProduction; cleanMost; buildall
}


alias env.number='env.getnumber'
