#!/bin/bash

# String utils

#include guard
if isFunctionDefined "string.defined" && ! isEnvVariableDefined "FORCE_IMPORT_UTILITY"
then
  return 0
fi

function string.defined() {
  return 0
}


# Main code starts here
function string.equals() {
  [[ "$1" == "$2" ]]
}

# basic wild card characters seems to work
function string.simplereplace() {
  local input="$1"
  local searchstring="$2"
  local replacestring="$3"
  echo "${input//$searchstring/$replacestring}"
}

function string.replacefirstoccurrence() {
  local input="$1"
  local searchstring="$2"
  local replacestring="$3"
  echo "${input/$searchstring/$replacestring}"
}

function string.beginswith() {
  local input="$1"
  local testString="$2"
  # Directly return true or false so that
  # it can be used with if
   [[ $input == $testString* ]]
}

function string.endswith() {
  local input="$1"
  local testString="$2"
  # Directly return true or false so that
  # it can be used with if
   [[ $input == *$testString ]]
}

function string.contains() {
  local input="$1"
  local testString="$2"
  # Directly return true or false so that
  # it can be used with if
   [[ $input == *$testString* ]]
}

# Returns 0 (true) if the string matches the given regex, 1 (false) otherwise
# NOTE: Perl style escapes like \d, \w etc. are not supported.
# It only supports extended regular expressions (ERE) -
# so use [0-9]+ instead of \d+ for example.
function string.matchesRegex() {
    local input="$1"
    local regex="$2"
    [[ "$input" =~ $regex ]]
}

function string.extractByRegex() {
  local source="$1"
  local regex="$2"

  local match
  match=$(echo "$source" | grep -Eo "$regex" | head -n 1)

  if [ -n "$match" ]; then
    echo "$match"
    return 0
  else
    return 1
  fi
}

# Tests whether the input string is empty ("")
# or just whitespace
function string.isemptyorblank() {
    [ -z "$1" ]
}

function string.isnotemptyorblank() {
    [ ! -z "$1" ]
}

function string.length() {
  echo ${#1}
}

function string.tolower() {
  echo "$1" | tr '[:upper:]' '[:lower:]'
}

function string.toupper() {
  echo "$1" | tr '[:lower:]' '[:upper:]'
}

function string.isnumber() {
  local regexNumber='^[0-9]+$'
  [[ "$1" =~ $regexNumber ]]
}

# ToDo: Implement for multiple strings.
function string.concatenate() {
  echo "$1$2"
}

# Prepend a string if it's not already prepended
function string.prependifnotalready() {
  local sourcestring="$1"
  local stringtoprepend="$2"
  if ! string.beginswith "$sourcestring" "$stringtoprepend"
  then
    sourcestring="$stringtoprepend""$sourcestring"
  fi
  echo "$sourcestring"
}

function string.trim() {
    local var="$*"
    # remove leading whitespace
    var="${var#"${var%%[![:space:]]*}"}"
    # remove trailing whitespace
    var="${var%"${var##*[![:space:]]}"}"
    echo "$var"
}

# Truncate a string to n characters
function string.truncate() {
    local input="$1"
    local n="$2"
    echo "${input:0:$n}"
}
