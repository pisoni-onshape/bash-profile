#!/bin/bash

#include guard
if isFunctionDefined "general.defined" && ! isEnvVariableDefined "FORCE_IMPORT_UTILITY"
then
  return 0
fi

function general.defined() {
  return 0
}

importutility string


# Add two integers
function general.add() {
  echo $(($1+$2))
}

# Subtract two integers
function general.subtract() {
  echo $(($1-$2))
}

# Parameter : message to show. Inputs "yes / y" or "no / n" and returns
# true for yes and false for no. Use with if.
function general.inputyesorno() {
  local message="$1"
  local colorHint="$2"
  local colorChanged="false"
  if string.equals $colorHint "caution"
  then
    color.red
    colorChanged="true"
  fi

  echo "$message (y/n)?"
  if string.equals $colorChanged "true"
  then
    color.reset
  fi

  while true; do
    read response

    response=$(string.tolower "$response")
    if [[ "$response" == "y" || "$response" == "yes" ]]; then
      return 0 # success
    elif [[ "$response" == "n" || "$response" == "no" ]]; then
      return 1 # failure
    else
      echo "Invalid input. Please enter 'y' or 'n'."
    fi
  done

  return 1
}

# Just pass a function name to it, should
# work for _most_ of them
function general.duration() {
  local time1=$SECONDS
  "$@" # Make the function call with its arguments. Smart.
  local time2=$SECONDS
  local duration=$(($time2-$time1))
  # However, if we call it with `echo`, it doesn't call the function.
  echo "Time taken to call $1 is $duration seconds"
}

# Pass the name of an array variable that contains
# keys and values in the form ("key1:value1" "key2:value2" .... )
# and the name of a function (callback) to call for each entry in
#  the array with the key and the value as its two arguments
function general.forEachKeyValue() {
    local arr_name="$1"    # name of array variable (NOT its contents)
    local callback="$2"    # callback function name

    # basic callback check
    if ! type "$callback" >/dev/null 2>&1; then
        echo "general.forEachKeyValue: callback '$callback' not found" >&2
        return 2
    fi

    shift 2                # remove first two arguments, rest are passed to callback

    # Copy the named array into a local array
    eval "local arr=(\"\${${arr_name}[@]}\")"

    # Iterate and split on the first colon
    for kv in "${arr[@]}"; do
        if [[ "$kv" == *:* ]]; then
            local key=$(string.trim "${kv%%:*}")    # before first colon
            local value=$(string.trim "${kv#*:}")   # after first colon (rest)
        else
            local key=$(string.trim "$kv")
            local value=""
        fi
        "$callback" "$key" "$value" "$@"
    done
}

function general.forEachArrayItem() {
    local arr_name="$1"    # name of array variable (NOT its contents)
    local callback="$2"    # callback function name

    if ! isFunctionDefined "$callback"
    then
      print_error "Invalid function name"
      return 1
    fi

    shift 2                # remove first two arguments, rest are passed to callback

    # Copy the named array into a local array
    eval "local arr=(\"\${${arr_name}[@]}\")"

    # Iterate and split on the first colon
    for item in "${arr[@]}"; do
        "$callback" "$item" "$@"
    done
}

function general.forEachDelimitedItem() {
    local string="$1"
    local delimiter="$2"
    local callback="$3"
    local temp="$string"
    local item

    if [ -z "$string" ]; then
        return
    fi

  if ! isFunctionDefined "$callback"
  then
    print_error "Invalid function name"
    return 1
  fi

    while [[ "$temp" == *"$delimiter"* ]]; do
        item="${temp%%"$delimiter"*}"
        "$callback" "$item"
        temp="${temp#*"$delimiter"}"
    done
    "$callback" "$temp"
}

# Pass newline separated string as the first argument
# and the function *name* to call on each of its newline
# delimited item
function general.forEachLine() {
    local string="$1"
    local callback="$2"
    general.forEachDelimitedItem "$string" $'\n' "$callback"
}

# Pass the function name that prints newline separated
# result as the first argument, and the name of the callback
# as the second, and any arguments to pass to the original
# function as the rest of arguments
function general.forEachOutputLine() {
    local func_name="$1"
    local callback="$2"

    if ! isFunctionDefined "$func_name"
    then
      print_error "Invalid function name for the base function to call"
      return 1
    fi

    if ! isFunctionDefined "$callback"
    then
      print_error "Invalid function name for the callback"
      return 1
    fi

    shift 2
    local result
    result=$("$func_name" "$@")

    general.forEachLine "$result" "$callback"
}

# Call by passing the *NAME* of the function
# and any desired arguments to call the function with.
# e.g.: `general.showtrueorfalse <funcName> [argument1 argument2 ...]`
# and this one (mostly)
function general.showtrueorfalse() {
  local functionName="$1"
  if ! isFunctionDefined "$functionName"
  then
    print_error "Invalid function name"
    return 1
  fi

  # Call the function by invoking it with '$'
  if "$functionName" ${@:2}
  then
    echo 'True'
    return 0
  else
    echo 'False'
    return 1
  fi
}

alias istrue='general.showtrueorfalse'

# Add auto completion to the 'istrue' command
complete -F __type_command_completion general.showtrueorfalse
# Some terminals work by just defining it for the original
# command, but some don't.
complete -F __type_command_completion istrue
