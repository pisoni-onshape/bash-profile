# composed of various servers, and their services.

# ToDo : Convert to importutility later.
# shellcheck source=../utils/system
source "$BASH_PROFILE_PATH/utils/system"
# shellcheck source=../utils/string
source "$BASH_PROFILE_PATH/utils/string"


# shellcheck source=./docker
source "$BASH_PROFILE_PATH/sources/docker"
# shellcheck source=./services
source "$BASH_PROFILE_PATH/sources/services"
# shellcheck source=./servers
source "$BASH_PROFILE_PATH/sources/servers"


# Create a new multi-environment clone for newton
# Argument: just the number 3 / 4 / 5 etc.
function env.create() {
  local newEnvNumber="$1"
  if string.isemptyorblank "$newEnvNumber"
  then
    print_error "Please give the environment number - 2 / 3 etc."
    return 1
  fi

  local newPath
  newPath=$(string.simplereplace "$REPO_NEWTON" "newton$(getEnvNumber)" "newton$newEnvNumber")
  if ! general.inputyesorno "Are you sure you want to create a new environment at $newPath?"
  then
    return 0
  fi

  if system.direxists "$newPath"
  then
    print_error "Directory $($newPath) already exists. Please give a new environment number"
    return 1
  fi

  # Begin creating the environment now.
  echo "Cloning the repository now. This might take a few minutes ..."
  git clone git@github.com:onshape/newton.git "$newPath"
  if ! system.waslastcommandsuccessful
  then
    echo "git clone was not successful. Please fix possible errors and start all over again."
    return 1
  fi

  # shellcheck disable=SC2164
  cd "$newPath"
  if ! system.waslastcommandsuccessful
  then
    echo "Change directory didn't succeed. Please check for possible errors and start again."
    return 1
  fi

  # shellcheck disable=SC1091
  source "buildenv.bash"
  if ! system.waslastcommandsuccessful
  then
    echo "source buildenv.bash didn't succeed. Please check for possible errors and start again."
    return 1
  fi

  btSetupEnv
  if ! system.waslastcommandsuccessful
  then
    echo "btSetupEnv didn't succeed. Please check for possible errors and start again."
    return 1
  fi

  # shellcheck disable=SC1091
  source "buildenv.bash"
  echo "Environment $newEnvNumber created successfully"
}


function env.check() {
  # 1. Check if docker is running.
  if docker.isrunning
  then
    echo "Docker is running"
  else
    echo "Docker is NOT running"
    return 1
  fi

  # 2. Check if all essential services are running.
  if ! fastcheckessentialservices
  then
    return 1
  fi

  # 3. Check if Onshape Server and grunt quickServe are running
  if ! areserversrunning
  then
    return 1
  fi

  # Success, everything seems to be working fine.
  return 0
}


function env.stopthis() {
  stopservers
  stopServices
}


# ToDo : This only kills services of all environments
# and Rancher desktop itself, but 'servers' of
# other environments keep running.
function env.stopall() {
  # Stop Onshape server and grunt quickServe
  stopservers

  if ! docker.isrunning
  then
    echo "Docker was already stopped, no services running."
    return 0
  fi

  # Stop all Docker services
  stopallservices
  # Finally, stop Rancher Desktop itself.
  echo "Killing Rancher Desktop"
  system.killallwithname "Rancher Desktop"
}

function env.start() {
  startServices
  startservers
}

function env.restart() {
  env.stopthis
  env.start
}


function env.fix() {
  if ! docker.isrunning
  then
    docker.startapp
  fi

  fixessentialservices

  startservers

  if ! isvalidonshapeserver
  then
    echo "Onshape server is running but is not functional. Restarting..."
    restartbelcad

    if ! isvalidonshapeserver
    then
      # It's still not valid for some reason
      print_error "Could not fix Onshape server"
      return 1
    fi
  fi

  if isdebuggingdrawings
  then
    #ToDo: Do it only if xenon is not already running
    startDrawingDocker skipupdate
  fi
}


function env.getnumber() {
  getEnvNumber
}
