# shellcheck source=./servers
source "$BASH_PROFILE_PATH/sources/servers"


# Create a new multi-environment clone for newton
# Argument: just the number 3 / 4 / 5 etc.
function env.create() {
  local newEnvNumber="$1"
  if string.isemptyorblank "$newEnvNumber"
  then
    print_error "Please give the environment number - 2 / 3 etc."
    return 1
  fi

  local newPath

  if string.isemptyorblank "$REPO_NEWTON"
  then
    echo "REPO_NEWTON is not set, assuming base repository path to be $HOME/repos"
    newPath="$HOME/repos/newton${newEnvNumber}"
  else
    newPath=$(string.simplereplace "$REPO_NEWTON" "newton$(env.getnumber)" "newton$newEnvNumber")
  fi

  if ! general.inputyesorno "Are you sure you want to create a new environment at $newPath"
  then
    echo "No changes were made to the system."
    return 0
  fi

  if system.direxists "$newPath"
  then
    print_error "Directory $newPath already exists. Please give a new environment number"
    return 1
  fi

  # Begin creating the environment now.
  echo "Cloning the repository now. This might take a few minutes ..."
  git clone git@github.com:onshape/newton.git "$newPath"
  if ! system.waslastcommandsuccessful
  then
    echo "git clone was not successful. Please fix possible errors and start all over again."
    return 1
  fi

  # shellcheck disable=SC2164
  cd "$newPath"
  if ! system.waslastcommandsuccessful
  then
    echo "Change directory didn't succeed. Please check for possible errors and start again."
    return 1
  fi

  # shellcheck disable=SC1091
  source "buildenv.bash"
  if ! system.waslastcommandsuccessful
  then
    echo "source buildenv.bash didn't succeed. Please check for possible errors and start again."
    return 1
  fi

  btSetupEnv
  if ! system.waslastcommandsuccessful
  then
    echo "btSetupEnv didn't succeed. Please check for possible errors and start again."
    return 1
  fi

  # shellcheck disable=SC1091
  source "buildenv.bash"
  echo "Environment $newEnvNumber created successfully. It's strongly recommended to open a new terminal window to start working in this env (cd $newPath, source buildenv.bash etc.)"
}


function env.check() {
  # 1. Check if docker is running.
  if docker.isrunning
  then
    echo "Docker is running"
  else
    echo "Docker is NOT running"
    return 1
  fi

  # 2. Check if all essential services are running.
  if ! fastcheckessentialservices
  then
    return 1
  fi

  # 3. Check if Onshape Server and grunt start are running
  if ! areserversrunning
  then
    return 1
  fi

  # Success, everything seems to be working fine.
  return 0
}


function env.stopthis() {
  stopservers
  stopServices
}

# Pass the name only of the function to call
# on each newton directory. It will be called
# once with the path of each newton multienv directory
# Caution: Must be called from a bashenv'd terminal
# Assumption: All newton envs are placed in the same directory
function env.foreachnewton() {
  local callback="$1"
  if string.isemptyorblank "$callback"
  then
    echo "Expected callback function name"
    return 1
  fi

  pushd $REPO_NEWTON/.. > /dev/null || return
  local currentPath="$(pwd)"
  echo "parentpath is: $parentPath"
  for d in newton newton[0-9]*; do
    [ -d "$d" ] && "$callback" "$currentPath/$d"
  done

  popd > /dev/null
}

