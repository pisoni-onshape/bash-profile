# ToDo : This only kills services of all environments
# and Rancher desktop itself, but 'servers' of
# other environments keep running.
function env.stopall() {
  # Stop Onshape server and grunt start
  stopservers

  if ! docker.isrunning
  then
    echo "Docker was already stopped, no services running."
    return 0
  fi

  # Stop all Docker services
  stopallservices
  # Finally, stop Rancher Desktop itself.
  echo "Killing Rancher Desktop"
  system.killallwithname "Rancher Desktop"
}

function env.start() {
  startServices
  startservers
}

function env.restart() {
  env.stopthis
  env.start
}


function env.fix() {
  if ! docker.isrunning
  then
    docker.startapp
  fi

  fixessentialservices

  startservers

  if ! isvalidonshapeserver
  then
    echo "Onshape server is running but is not functional. Restarting..."
    restartbelcad

    if ! isvalidonshapeserver
    then
      # It's still not valid for some reason
      print_error "Could not fix Onshape server"
      return 1
    fi
  fi

  if isdebuggingdrawings
  then
    if ! isdrawingservicerunning
    then
      startDrawingDocker skipupdate
    fi
  fi
}

function __filterAndShow() {
  local serviceName="$1"
  # Does it belong to the set of 'shared' services (among all envs)
  if isASharedService "$serviceName"
  then
    echo "$serviceName"
  else
    local envNum=$(env.getnumber)
    if string.equals "$envNum" "0"
    then
      if ! string.contains "$serviceName" "_myenv"
      then
        echo "$serviceName"
      fi
    else
      if string.endswith "$serviceName" "_myenv$envNum"
      then
        echo "$serviceName"
      fi
    fi
    local suffix="myenv$(env.getnumber)"
  fi
}

# Returns the names of services
# that are applicable only for this
# env, unlike docker.runningServices
function env.runningServices() {
  #docker.runningServices
  general.forEachOutputLine docker.runningServices __filterAndShow
}

# Callback used by general.forEachKeyValue to print status lines
# Receives two args: key (service name before colon) and value (after colon)
function __printservicestatus() {
  local serviceName="$1" #Key
  local _value="$2" # Value, unused

  local envNum
  envNum=$(env.getnumber)
  local suffix=""
  suffix=$(getEnvServiceSuffixOrFullServiceName "") #Empty argument to only get suffix

  if string.contains "$serviceName" "<envsuffix>"
  then
    serviceName=$(string.simplereplace "$serviceName" "<envsuffix>" "$suffix")
  fi

  # runningList is expected to be set in the caller
  local running=0
  if [ -n "${runningList-}" ] && echo "$runningList" | grep -Fxq "$serviceName"; then
    running=1
  fi

  echo "${serviceName}:${running}"
}

function __printNonSharedServiceStatus() {
  local serviceName="$1" #Key
  local _value="$2" # Value, unused
  if ! isASharedService "$serviceName"
  then
    __printservicestatus "$serviceName"
  fi
}

function env.statusNonSharedServices() {
  runningList=$(env.runningServices)
  general.forEachKeyValue ALL_SERVICES_AND_COMMANDS __printNonSharedServiceStatus
}


# Print status for all services declared in ALL_SERVICES_AND_COMMANDS.
# Uses general.forEachKeyValue to split key/value on ':' automatically.
function env.statusall() {
  # Ensure services list is populated
  declareAllServices

  local envNum
  envNum=$(env.getnumber)

  # Print core items first
  if docker.isrunning; then
    echo "docker:1"
  else
    echo "docker:0"
  fi

  if isonshapeserverrunning; then
    echo "onshape_server:1"
  else
    echo "onshape_server:0"
  fi

  if isquickserverunning; then
    echo "quickserve:1"
  else
    echo "quickserve:0"
  fi

  if isdrawingservicerunning; then
    echo "drawing_server:1"
  else
    echo "drawing_server:0"
  fi

  # Capture running services (env-aware) for callback use
  runningList=$(env.runningServices)

  general.forEachKeyValue ALL_SERVICES_AND_COMMANDS __printservicestatus
}


alias startenv='env.start'
alias checkenv='env.check'
alias stopenv='env.stopthis'
alias restartenv='env.restart'
alias fixenv='env.fix'
