}


# Combined getter for all build and server properties
# Returns: JAVA,JS,CPP,BTUPGRADE,RUNSERVERS,QUICKSERVE,DRAWINGS,AUTOLAUNCH (1=true, 0=false)
function __settings.getbuildandserverproperties() {
  local java js cpp btupgrade runservers quickserve drawings autolaunch

  if settings.isbuildingjava; then java=1; else java=0; fi
  if settings.isbuildingjs; then js=1; else js=0; fi
  if settings.isbuildingcpp; then cpp=1; else cpp=0; fi
  if settings.isrunningbtupgrade; then btupgrade=1; else btupgrade=0; fi
  if settings.isrunselectedserversonsuccessfulbuild; then runservers=1; else runservers=0; fi
  if settings.isusingquickserve; then quickserve=1; else quickserve=0; fi
  if settings.isdebuggingdrawings; then drawings=1; else drawings=0; fi
  if settings.isautolaunchingonsuccessfulbuild; then autolaunch=1; else autolaunch=0; fi

  echo "${java},${js},${cpp},${btupgrade},${runservers},${quickserve},${drawings},${autolaunch}"
}
