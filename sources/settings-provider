# NEWTON_WEBPACK_SERVE_ON_LAN
# Would be fine with just the config property
# but the webpack process needs this env variable.
function settings.setserveonlan() {
  if string.equals "$1" "false"
  then
    unset NEWTON_WEBPACK_SERVE_ON_LAN
      env.setproperty "NEWTON_WEBPACK_SERVE_ON_LAN" "false"
  else
    export NEWTON_WEBPACK_SERVE_ON_LAN=1
    env.setproperty "NEWTON_WEBPACK_SERVE_ON_LAN" "true"
  fi

  if general.inputyesorno "Webpack will now serve on LAN. Do you want to start quickserve now/restart it if already running"
  then
    if isquickserverunning
    then
      echo "Restarting quickserve to apply the new setting"
      restartquickserve
    else
      echo "Starting quickserve to apply the new setting"
      quickserve
    fi
  else
    echo "Webpack will serve on LAN when you start quickserve next time."
  fi
}

function settings.isservingonlan() {
  local servingOnLan="false"
  servingOnLan=$(env.getproperty "NEWTON_WEBPACK_SERVE_ON_LAN" "false")
  string.equals "$servingOnLan" "true" || string.equals "$servingOnLan" "1"
}

function settings.resetserveonlan() {
  settings.setserveonlan "false"
}


