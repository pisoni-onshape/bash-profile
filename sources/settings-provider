function settings.getglobalsettingsvalue() {
  local settingname="$1"
  local defaultvalue="${2:-}"
  local value=$(system.getkeyvaluefromfile "$BASH_PROFILE_SETTINGS_PATH" "$settingname" "$defaultvalue")
  if string.contains "$value" '$ENVNUM'
  then
    value=$(string.simplereplace "$value" '$ENVNUM' "$(env.getnumber)")
  fi

  if string.contains "$value" '$HOME'
  then
    value="$(string.simplereplace "$value" '$HOME' "$HOME")"
  fi

  if string.contains "$value" '~'
  then
    value="$(string.simplereplace "$value" '~' "$HOME")"
  fi

  echo "$value"
}

function settings.setglobalsettingsvalue() {
  local settingname="$1"
  local value="$2"
  system.setkeyvalueinfile "$BASH_PROFILE_SETTINGS_PATH" "$settingname" "$value"
}

function settings.deleteglobalsettingsvalue() {
  local settingname="$1"
  system.deletekeyvaluefromfile "$BASH_PROFILE_SETTINGS_PATH" "$settingname"
}

function __getenabledvalue() {
  local enabled="$1"
  if string.equals "$enabled" "false"
  then
    enabled="false"
  else
    enabled="true"
  fi
  echo "$enabled"
}


# Default Browser. Pass the URL to open in the browser.
function settings.openwithdefaultbrowser() {
    local browserPath="$(settings.getglobalsettingsvalue "DEFAULT_BROWSER_PATH" "/Applications/Google Chrome.app")"
    local browserArgs="$(settings.getglobalsettingsvalue "DEFAULT_BROWSER_ARGUMENTS" "--inspect --remote-debugging-port=9222")"
    local userDataDir="$(settings.getglobalsettingsvalue "DEFAULT_BROWSER_USER_DATA_DIRECTORY" "")"
    if ! string.isemptyorblank "$userDataDir"
    then
      userDataDir="$(system.getcanonicalpath "$userDataDir")"
      if string.contains "$browserPath" "firefox" -i || string.contains "$browserPath" "zen" -i
      then
        # Firefox and the Zen browser (fork of Firefox) use the profile directory format.
        open -n -a "$browserPath" --args $browserArgs -profile "$userDataDir" "$@"
      else
        # Most other browsers these days are forks of Chromium
        # so use the same user data directory format.
        open -n -a "$browserPath" --args $browserArgs --user-data-dir="$userDataDir" "$@"
      fi
    else
      open -n -a "$browserPath" --args $browserArgs "$@"
    fi
}

# USING_QUICKSERVE
function settings.setusingquickserve() {
  local enabled=$(__getenabledvalue "$1")
  env.setproperty "USING_QUICKSERVE" "$enabled"
}

function settings.isusingquickserve() {
  local usingQuickserve="false"
  usingQuickserve=$(env.getproperty "USING_QUICKSERVE" "true")
  string.equals "$usingQuickserve" "true"
}

function settings.resetusingquickserve() {
  settings.setusingquickserve "false"
}


function __setdrawingsexports() {
  local enabled=$(__getenabledvalue "$1")

  if string.equals "$enabled" "true"
  then
    export ENABLE_THUMBNAIL_SERVICE=1
    export START_RENDERER_IN_MAIN_THREAD=1
    # disable if debugging thumbnails.
    export BTI_BLOCK_THUMBNAIL_CPP_SERVER_POOL=1
  else
    unset ENABLE_THUMBNAIL_SERVICE
    unset START_RENDERER_IN_MAIN_THREAD
    unset BTI_BLOCK_THUMBNAIL_CPP_SERVER_POOL
  fi
}

# DEBUGGING_DRAWINGS
function settings.setdebuggingdrawings() {
  local enabled=$(__getenabledvalue "$1")
  env.setproperty "DEBUGGING_DRAWINGS" "$enabled"
  __setdrawingsexports "$enabled"
}


function settings.isdebuggingdrawings() {
