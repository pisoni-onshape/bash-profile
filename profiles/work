function monitorenv() {
  export MONITORING_ENV="true"
  local wasWorkingBefore="false"

  while env.check; do
    echo ""
    echo $(system.getcurrentdate)
    wasWorkingBefore="true"
    sleep 5
  done

  unset MONITORING_ENV

  if string.equals $wasWorkingBefore "true"
  then
    beep;beep
    local message="Something has crashed in Environment $(env.getnumber)"
    echo $message
    say $message
    return 1
  else
    echo "Environment check failed."
    return 1
  fi
}


