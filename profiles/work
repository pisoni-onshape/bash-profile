# Merge a branch to master following the complete process outlined in Onshape's Software Release Process
# (https://belmonttechinc.atlassian.net/wiki/spaces/DEV/pages/10387559/Software+Release+Process)
# Syntax: Call `mergetomaster [review-request-id]` - review-request-id is optional. If you don't pass
# it, it will automatically find the *approved* RBCommons Review request with the same branch name.
# If it's not approved it won't be merged. It works as expected as long as the branch was originally
# created by checkoutfromlsbmaster or checkoutfrommaster - which merely adds a "-lsb-master" or "-master"
# at the end of the branch to denote the original branch it was based off of.
function mergetomaster() {
  ensurenewtondirectory
  local reviewrequestid="$1"

  if git.hasUncommittedChanges
  then
    echo "There are uncommitted changes. Please fix before merging to master"
    return 1
  fi

  if git.isoneoftheofficialbranches
  then
    echo "Wrong branch. You should call it on your feature branch and not on one of the official branches"
    return 1
  fi

  if ! git.branchislsbmasterbased && ! git.branchismasterbased
  then
    echo "Branch is not lsb/master or master based (Was it created using checkoutfrommaster or checkoutfromlsbmaster?). It is checked by whether the branch name ends with "-master" or "-lsb-master"). Please fix and try again"
    return 1
  fi

  # Check if a specific rbcommons review request id is given
  # Search for an approved request for the current git branch if not.
  if string.isemptyorblank "$reviewrequestid" && ! isreverting # If reverting we don't need to pull review request id
  then
    reviewrequestid=$(rbt.getcurrentid $rbt_REVIEW_STATUS_APPROVED)
    if string.isemptyorblank $reviewrequestid || ! string.isnumber $reviewrequestid
    then
      echo "Didn't find an approved review request for the branch, enter manually."
      return 1
    else
      echo "Automatically found approved review request id: $reviewrequestid for current branch, using that for merging."
    fi
  fi

  # Start the merging process now.
  local currentbranch=$(git.getcurrentbranch)

  if string.isemptyorblank $(git.getbugnumberfrombranch)
  then
    # No bug number found in the branch name. Merge without a bug number if the user agrees.
    if user_agrees_to "Branch name does not contain a bug number. Do you want to merge with '--no-resolve'?"
    then
      echo "Sure, will mergepush with --no-resolve"
      setnoresolve
    else
      echo "No bug number found in the branch name. Please ensure the branch name is of the form <username>/bel-xxxxxx[/optional-description]-[lsb/master/lsb/rel-*.***] and run again. Or, you could just create the branch name using checkoutfromlsbmaster or checkoutfromlsbrelease"
      return 1
    fi
  fi

  # Actually check for no-resolve here
    local noresolvestring=""
    if getisnotresolving
    then
      noresolvestring="--no-resolve"
    fi

    local ignorebuildfarmstring=""
    if getignorebuildfarmforrbcommons
    then
      ignorebuildfarmstring="--no-build-farm"
    fi

  # Step 1: Rebase latest master branch (regardless of whether it was an lsb/master based branch or just master based)
  rebaselatestbranch "master"
  if ! system.waslastcommandsuccessful
  then
    echo "Rebase didn't succeed. Please manually rebase/pull latest master branch and try again."
    return 1
  fi

  waitforenterkey "Press enter if rebase is successful to continue to merge to master"

  # Step 2: Checkout master
  git checkout master
  if ! system.waslastcommandsuccessful
  then
    echo "git checkout failed, did not merge to master"
    return 1
  fi

  # If we are reverting this branch from master (this branch itself was
  # previously merged, and we are calling `revertbranchfrommaster` function)
  # then we don't need a review request id
  if isreverting
  then
    echo "Calling  mergepush $currentbranch --no-review -m \"$reviewrequestid\""
    mergepush "$currentbranch" --no-review -m "$reviewrequestid" # In this case the first argument is the revert comment.
    if system.waslastcommandsuccessful
    then
      setnotreverting
    fi
  else
    # Step 3: Call mergepush
    local cmd="mergepush $currentbranch -r $reviewrequestid $noresolvestring $ignorebuildfarmstring"
    echo "Calling $cmd"
    mergepush $currentbranch -r $reviewrequestid $noresolvestring $ignorebuildfarmstring
    if system.waslastcommandsuccessful
    then
      git checkout $currentbranch
      # This is not really needed, but rename the current branch as 'merged' to keep for
      # a few days in case you need to revert it. It can be deleted later.
      markbranchmerged $currentbranch
      unsetnoresolve
      unsetignorebuildfarmforrbcommons
    else
      echo "mergepush was not succecsful, please call it again on the master."
      return 1
    fi
  fi
}

# Revert a branch you merged to master. You should be on the branch
# to revert for calling this.
# Please make sure all the changes you did are in a single top
# commit in this branch (Squash changes first if that's not the case).
# The revert branch would be created by cherry picking the top-most commit
# in that branch.
function revertbranchfrommaster() {
  local revertcomment="$1"
  if string.isemptyorblank "$revertcomment"
  then
    echo "Please enter a revert comment in quotes as input to this command (try again)."
    return
  fi

  ensurenewtondirectory

  if git.hasUncommittedChanges
  then
    echo "There are uncommitted changes. Please fix before merging to master"
    return
  fi

  if git.isoneoftheofficialbranches
  then
    echo "Wrong branch. You should call it on your feature branch and not on one of the official branches"
    return
  fi

  if ! git.branchislsbmasterbased && ! git.branchismasterbased
  then
    echo "Branch is not lsb/master or master based. Please check and try again"
    return
  fi

  waitforenterkey "Press enter to proceed only if there are no FeatureScript changes. If there are, press Ctrl+C and do it manually."

  git log -n 3
  waitforenterkey "Press enter if all of your changes are in one top commit, and ready to create the revert branch from it (Otherwise press Ctrl+C and try again after squashing them to one change, or do manually)."
  createrevertmasterbranchfrombranchtopchange

  if ! system.waslastcommandsuccessful
  then
    echo "Revert has merge problems. Resolve those, and then merge the branch to master using mergetomaster"
    return
  fi

  waitforenterkey "Press enter if the revert commit was successful, else press Ctrl+C and mergetomaster later."
  setreverting
  mergetomaster "$revertcomment"
}

