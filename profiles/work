function refreshcurrentreleasebranch() {
  ensurenewtondirectory
  local arg="$1"
  local latestremoterelease=""
  if string.equals "$arg" "--slow" || string.equals "$arg" "--force" || string.equals "$arg" "--remote" || string.equals "$arg" "-f" || string.equals "$arg" "-r"
  then
    echo "Fetching latest current release branch from the remote repository ..."
    local successful="false"
    local branchref=$(git ls-remote -q | grep -E "refs/heads/rel-\d+\.\d+$" | awk '{print $2}' | sort -V | tail -n 1)
    if string.isnotemptyorblank "$branchref"
    then
      latestremoterelease=$(string.simplereplace "$branchref" "refs/heads/" "")
      if string.beginswith "$latestremoterelease" "rel-"
      then
        successful="true"
      fi
    fi

    if string.equals "$successful" "false"
    then
      print_error "Could not find latest remote release branch. Please check if you're in the correct directory and git is working as expected."
      return 1
    fi
  else
    latestremoterelease=$(git branch -r | grep -E "origin/rel-\d+\.\d+$" | sort -V | tail -n 1)
  fi

  if ! system.waslastcommandsuccessful || string.isemptyorblank $latestremoterelease
  then
    print_error "Could not find latest remote release branch. Please check if you're in the correct directory and git is working as expected."
    return 1
  fi

  CURRENT_RELEASE=$(string.simplereplace $latestremoterelease "origin/" "")
  # Refresh the current lsb release branch as well.
  LSB_CURRENT_RELEASE=lsb/$CURRENT_RELEASE
  echo "CURRENT_RELEASE set to $CURRENT_RELEASE"

  # Write current release to a file
  env.writevartodisk CURRENT_RELEASE
}

