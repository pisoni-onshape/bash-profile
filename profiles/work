# Pass jira number, or leave blank for picking
# bug number from the branch name.
function openbug() {
  local bugNumber="$1"
  if string.isemptyorblank "$bugNumber"
  then
    # Assume we're trying to open the bug number contained in the branch
    bugNumber=$(git.getbugnumberfrombranch)
    if string.isemptyorblank "$bugNumber"
    then
      echo "Bug number not provided, and can't find one from the branch name."
      return
    fi
  fi

  bugNumber=$(string.toupper $bugNumber)
  if string.isnumber $bugNumber
  then
    # Take BEL by default.
    bugNumber="BEL-$bugNumber"
  fi

  open "https://belmonttechinc.atlassian.net/browse/$bugNumber"
}

function openbugfolder() {
  local bugNumber="$1"
  if string.isemptyorblank "$bugNumber"
  then
    # Assume we're trying to open the bug number contained in the branch
    bugNumber=$(git.getbugnumberfrombranch)
    if string.isemptyorblank "$bugNumber"
    then
      echo "Bug number not provided, and can't find one from the branch name."
      return
    fi
  fi

  bugNumber=$(string.simplereplace $(string.tolower $bugNumber) "bel-" "")
  bugNumber="BEL-$bugNumber"
  local bugsFolder=""
  if system.direxists "$HOME/Bugs"
  then
    bugsFolder="$HOME/Bugs"
  elif system.direxists "$HOME/Library/CloudStorage/OneDrive-PTC"
  then
    bugsFolder="$HOME/Library/CloudStorage/OneDrive-PTC/Documents/Bugs"
    system.createdirifdoesnotexist "$bugsFolder"
    # Create a symbolic link for this bug folder to the $HOME directory
    # for easy access later
    system.createsymboliclinkfromto "$bugsFolder" "$HOME/Bugs"
  fi

  system.createdirifdoesnotexist "$bugsFolder/$bugNumber"

  # Do a success check
  if ! system.direxists "$bugsFolder/$bugNumber"
  then
    print_error "Cannot create bug folder. Please create a 'Bugs' folder in $HOME, check write permissions and try again"
    return 1
  fi

  open "$bugsFolder/$bugNumber"
}

