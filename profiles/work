function importextractedfile() {
  if string.isemptyorblank "$1"
  then
    print_error "Please provide file path to restore."
    return 1
  fi
  local filePath="$1"
  local time1=$SECONDS
  waitforenterkey "If the file doesn't include std, make sure you've run 'mongoDropToProduction' and 'gradle runBtUpgrade' before this (press enter if yes, and Ctrl+C if you haven't)"
  # restoreDump "$filePath" --nodrop --remap=btadmin@onshape.com
  restoreDump "$filePath" --nodrop --remap=pisoni@onshape.com
  local time2=$SECONDS
  local duration=$(($time2-$time1))
  echo "Time taken in restore: $duration seconds"
  say "Document import complete"
  if ! general.inputyesorno "Do you want to open the document now?"
  then
    local documentId=$(echo "$filePath" | sed 's/.*new-\([^-]*\)-.*/\1/')
    if string.isemptyorblank "$documentId"
    then
      print_error "Could not find documentId from path. Looked for string between 'new-' and next '-'"
      return 1
    else
      local onshapePath="$(getdefaultonshapepath)/documents/$documentId"
      open "$onshapePath"
    fi
  fi
}

